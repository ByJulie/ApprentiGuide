# copy to .env; never commit .env
# free key: https://console.groq.com/keys
GROQ_API_KEY=
# optional: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# PISTE (Legifrance API): https://piste.gouv.fr, OAuth client credentials
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# local PostgreSQL (db/docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://apprentiguide:<POSTGRES_PASSWORD>@127.0.0.1:5432/apprentiguide

# host port of the local database (default 5432; change it if another PostgreSQL already uses 5432)
DB_PORT=5432
